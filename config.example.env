# oci-a1-claimer 設定檔範本
# 複製為 config.env 後填寫，並執行 chmod 600 config.env。
# 同名環境變數會覆寫這裡的值（空字串代表使用預設值）。相對路徑以本檔所在目錄為基準。

# ===== 網路與金鑰（必填）=====

# 實例要放入的子網 OCID。要公網 IP 就必須是公有子網。
# 主控台：Networking → Virtual Cloud Networks → 你的 VCN → Subnets
SUBNET_ID=ocid1.subnet.oc1..replace-me

# 注入實例的 SSH 公鑰（.pub）
SSH_PUBLIC_KEY_FILE=secrets/ssh.pub

# ===== OCI 認證與區域 =====

# 標準 OCI CLI / SDK 設定檔與 profile；setup.sh 會把其中的 key_file 指向 secrets/oci_api_key.pem
OCI_CONFIG_FILE=secrets/oci_config
OCI_PROFILE=DEFAULT

# 目標 region，例如 ap-tokyo-1；留空則使用上面 profile 的 region
# REGION=
# 只允許在 home region 建立（Always Free 運算實例只能在 home region）；設 false 時只警告
REQUIRE_HOME_REGION=true

# 實例所在 compartment；留空則使用 tenancy（root compartment）
# COMPARTMENT_ID=ocid1.compartment.oc1..replace-me

# ===== 規格與免費額度（必填）=====
# 依官方 Always Free 文件（https://docs.oracle.com/en-us/iaas/Content/FreeTier/freetier_topic-Always_Free_Resources.htm）
# 與主控台 Governance → Limits, Quotas and Usage 填寫。
# 額度是所有 A1.Flex 實例合計；可一台用滿，也可拆成多台。

OCPUS=2
MEMORY_GB=12
FREE_OCPU_LIMIT=2
FREE_MEMORY_GB_LIMIT=12
# 用量檢查預設只看 COMPARTMENT_ID；其他 compartment 也有 A1 實例時在此列出（逗號分隔）
# USAGE_EXTRA_COMPARTMENT_IDS=

DISPLAY_NAME=a1-claimer
# 開機磁碟大小（GB，最小 50），計入免費區塊儲存總量
BOOT_VOLUME_GB=50
# 是否指派公網 IP（true / false）
ASSIGN_PUBLIC_IP=true

# 只輪詢指定的 AD（逗號分隔；可填完整名稱或結尾，例如 AD-1,AD-3）。留空 = 全部。
# AVAILABILITY_DOMAINS=

# ===== 映像檔 =====

# 直接指定映像檔 OCID；設定後忽略下面的自動挑選條件
# IMAGE_ID=ocid1.image.oc1..replace-me

# 自動挑選：作業系統名稱（OCI 的 operating_system 欄位，例如 "Canonical Ubuntu"、"Oracle Linux"）
IMAGE_OS=Canonical Ubuntu
# 只接受特定版本（例如 24.04）；留空 = 不限
# IMAGE_OS_VERSION=
# 排除名稱含 Minimal 的映像檔
IMAGE_EXCLUDE_MINIMAL=true
# 優先選 Ubuntu LTS（偶數年 .04）；對其他作業系統無作用
IMAGE_PREFER_LTS=true

# ===== 重試節奏（秒） =====

# 每輪（所有 AD 各試一次）之間的休息時間，另加 0 ~ JITTER_SECONDS 的隨機值
INTERVAL_SECONDS=120
JITTER_SECONDS=30
# 同一輪內，AD 之間的間隔
PER_AD_DELAY_SECONDS=5
# 429 退避：第一次 RATE_LIMIT_SLEEP_SECONDS，連續 429 時加倍，上限 RATE_LIMIT_MAX_SLEEP_SECONDS
RATE_LIMIT_SLEEP_SECONDS=300
RATE_LIMIT_MAX_SLEEP_SECONDS=1800
# 網路錯誤 / 5xx 的指數退避：第 n 次等 BASE×2^(n-1) 秒，上限 MAX，另加最多 20% jitter
TRANSIENT_RETRY_BASE_SECONDS=10
TRANSIENT_RETRY_MAX_SECONDS=300
# 同一 AD 遇到非容量類 5xx 或可重試的 409 時，以同一 token 最多嘗試幾次（含第一次）後換 AD；結果不明時不受此限
TRANSIENT_MAX_ATTEMPTS_PER_AD=3

# ===== 建立後 =====

# 等待 RUNNING、等待公網 IP 的逾時
RUNNING_TIMEOUT_SECONDS=900
PUBLIC_IP_TIMEOUT_SECONDS=300
# state.json / result.json / pending_launch.json 的存放目錄
STATE_DIR=state

# ===== 通知（選用）=====
# 兩者都填才會啟用。token 不會出現在 log 中。
# TG_BOT_TOKEN=
# TG_CHAT_ID=
# 每隔幾小時回報一次進度（已嘗試次數等），用來確認程式仍在執行；0 = 不回報
HEARTBEAT_HOURS=24

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
